# Neon PostgreSQL — Pooled connection (used at runtime)
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Neon PostgreSQL — Direct connection (used by drizzle-kit for migrations)
DIRECT_URL="postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require"

# NextAuth v5 — 32+ character random secret (generate with: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-32-plus-character-random-secret-string"

# App URL (Use your production domain on Vercel, e.g. https://your-app.vercel.app)
NEXTAUTH_URL="http://localhost:3000"

# ─────────────────────────────────────────────────────────────
# Brevo (Sendinblue) Transactional Email Service
# Configure these in .env.local for local dev, and in Vercel:
# Project Settings -> Environment Variables
# ─────────────────────────────────────────────────────────────
# 1. Brevo v3 API Key (Get from: https://app.brevo.com/settings/keys/api)
BREVO_API_KEY="xkeysib-your-actual-api-key"

# 2. Verified Sender Email (MUST be added and verified in Brevo: Senders & IP -> Senders)
BREVO_SENDER_EMAIL="your-verified-email@example.com"

# 3. Sender Display Name
BREVO_SENDER_NAME="PeoplePay360"

# 4. (Optional) Test Recipient Override (routes all payslip emails to this inbox for testing)
# BREVO_TEST_RECIPIENT="your-personal-email@example.com"
